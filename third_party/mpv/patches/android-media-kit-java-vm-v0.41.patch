+/**
+ * Android media_kit bridge for statically-linked FFmpeg.
+ *
+ * Pass the process JavaVM* to libavcodec so MediaCodec can obtain a JNI
+ * environment. This is intentionally a narrow downstream compatibility API;
+ * it is not part of upstream libmpv.
+ *
+ * @return the result from av_jni_set_java_vm().
+ */
+MPV_EXPORT int mpv_lavc_set_java_vm(void *vm);
